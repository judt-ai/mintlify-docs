{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Judt",
  "theme": "maple",
  "colors": {
    "primary": "#E43636",
    "light": "#FFFFFF",
    "dark": "#000000"
  },
  "favicon": {
    "light": "/images/red-01.svg",
    "dark": "/images/red-01.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Manage Apps",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "manage/introduction",
              "manage/quickstart",
              "manage/authentication"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "manage/concepts/apps",
              "manage/concepts/sandbox",
              "manage/concepts/deployments",
              "manage/concepts/secrets",
              "manage/concepts/previews",
              "manage/concepts/retries",
              "manage/concepts/errors"
            ]
          },
          {
            "group": "Interfaces",
            "pages": [
              "manage/interfaces/api",
              "manage/interfaces/mcp",
              "manage/interfaces/agent"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "manage/guides/agent-access",
              "manage/guides/publish",
              "manage/guides/troubleshoot"
            ]
          }
        ]
      },
      {
        "tab": "Build Apps",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "build/introduction",
              "build/app-contract",
              "build/cloudflare-differences",
              "build/dev-server"
            ]
          },
          {
            "group": "Project",
            "pages": [
              "build/wrangler-json",
              "build/npm-and-builds",
              "build/static-assets",
              "build/vars-and-secrets"
            ]
          },
          {
            "group": "Storage",
            "pages": [
              "build/storage/durable-objects",
              "build/storage/d1",
              "build/storage/kv",
              "build/storage/r2"
            ]
          },
          {
            "group": "Background work",
            "pages": [
              "build/background/queues",
              "build/background/cron-triggers",
              "build/background/workflows"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "build/advanced/dynamic-workers",
              "build/advanced/facets",
              "build/advanced/agent-loop"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "build/reference/runtime"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "api-reference/openapi.json",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Apps",
            "pages": [
              "POST /api/apps",
              "GET /api/apps",
              "GET /api/apps/{id}",
              "PATCH /api/apps/{id}",
              "DELETE /api/apps/{id}",
              "POST /api/apps/{id}/access"
            ]
          },
          {
            "group": "Secrets",
            "pages": [
              "GET /api/apps/{id}/secrets",
              "PUT /api/apps/{id}/secrets",
              "GET /api/apps/{id}/secrets/{secret}",
              "PUT /api/apps/{id}/secrets/{secret}",
              "DELETE /api/apps/{id}/secrets/{secret}"
            ]
          },
          {
            "group": "Files",
            "pages": [
              "GET /api/apps/{id}/files",
              "GET /api/apps/{id}/files/{path}",
              "PUT /api/apps/{id}/files/{path}",
              "DELETE /api/apps/{id}/files/{path}"
            ]
          },
          {
            "group": "Sandbox",
            "pages": [
              "POST /api/apps/{id}/command",
              "GET /api/apps/{id}/git",
              "POST /api/apps/{id}/commits",
              "GET /api/apps/{id}/commits",
              "POST /api/apps/{id}/restore",
              "POST /api/apps/{id}/preview",
              "POST /api/apps/{id}/stop"
            ]
          },
          {
            "group": "Deployments",
            "pages": [
              "POST /api/apps/{id}/deployments",
              "GET /api/apps/{id}/deployments",
              "GET /api/apps/{id}/deployments/{deployment_id}",
              "POST /api/apps/{id}/unpublish"
            ]
          },
          {
            "group": "Monitoring",
            "pages": [
              "GET /api/apps/{id}/events",
              "GET /api/apps/{id}/logs"
            ]
          },
          {
            "group": "Templates",
            "pages": [
              "GET /api/templates"
            ]
          },
          {
            "group": "Agents",
            "pages": [
              "GET /api/models",
              "POST /api/apps/{id}/sessions",
              "GET /api/apps/{id}/sessions",
              "GET /api/apps/{id}/sessions/{session_id}",
              "PATCH /api/apps/{id}/sessions/{session_id}",
              "DELETE /api/apps/{id}/sessions/{session_id}",
              "POST /api/apps/{id}/sessions/{session_id}/turns",
              "GET /api/apps/{id}/sessions/{session_id}/turns",
              "GET /api/apps/{id}/sessions/{session_id}/turns/{turn_id}",
              "POST /api/apps/{id}/sessions/{session_id}/turns/{turn_id}/cancel",
              "POST /api/apps/{id}/sessions/{session_id}/turns/{turn_id}/decline",
              "GET /api/apps/{id}/sessions/{session_id}/events"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Go to Dashboard",
      "href": "https://app.judt.com"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "seo": {
    "indexing": "all"
  },
  "description": "Give your agent the ability to build and publish powerful, realtime, dynamic Apps and Websites.",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "logo": {
    "light": "/images/judt-logo.svg",
    "dark": "/images/judt-logo.svg",
    "href": "https://judt.ai"
  }
}
